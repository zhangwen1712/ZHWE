{
  "name": "zhwe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/generate-site-files.mjs && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview --host 127.0.0.1",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "maplibre-gl": "^6.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "cf": "^1.0.0-rc.2",
    "lighthouse": "^13.6.0",
    "node": "^22.23.4",
    "pagefind": "1.6.0"
  }
}
