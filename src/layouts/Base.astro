---
import '../styles/site.css';
import { labels, languages, localPath, searchLabels } from '../i18n.js';
const {lang='en', title='ZHWE', description='', ogImage='', ogType='website', publishedTime='', modifiedTime='', is404=false} = Astro.props;
const t=labels[lang];
const siteName='ZHWE';
const pageDescription=description || t.tagline;
const ogLocale={en:'en_US',zh:'zh_CN','zh-Hant':'zh_TW',fr:'fr_FR',es:'es_ES',it:'it_IT',de:'de_DE'}[lang] || 'en_US';
const originalPath=Astro.url.pathname.replace(/^\/(zh-Hant|zh|fr|es|it|de)(?=\/|$)/,'') || '/';
const pageUrl=new URL(localPath(originalPath,lang),Astro.site);
---
<!doctype html><html lang={lang === 'zh' ? 'zh-CN' : lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#f8f7fb"/><meta name="robots" content="index,follow"/><meta name="description" content={pageDescription}/>
{!is404 && <><link rel="canonical" href={new URL(localPath(originalPath,lang),Astro.site)}/>{Object.keys(languages).map(key=><link rel="alternate" hreflang={key === 'zh' ? 'zh-CN' : key} href={new URL(localPath(originalPath,key),Astro.site)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(originalPath,Astro.site)}/><meta property="og:type" content={ogType}/><meta property="og:site_name" content={siteName}/><meta property="og:locale" content={ogLocale}/><meta property="og:title" content={title}/><meta property="og:description" content={pageDescription}/><meta property="og:url" content={pageUrl}/>{ogImage && <meta property="og:image" content={ogImage}/>}{publishedTime && <meta property="article:published_time" content={publishedTime}/>}{modifiedTime && <meta property="article:modified_time" content={modifiedTime}/>}<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={pageDescription}/>{ogImage && <meta name="twitter:image" content={ogImage}/>}</>}<title set:html={title}/><script is:inline>
(function(){try{var saved=localStorage.getItem('zhwe-theme'),legacy=localStorage.getItem('zhwe-dark');var mode=['light','dark','system'].includes(saved)?saved:(legacy==='1'?'dark':legacy==='0'?'light':'system');document.documentElement.classList.toggle('dark-mode',mode==='dark'||(mode==='system'&&matchMedia('(prefers-color-scheme: dark)').matches));}catch(e){document.documentElement.classList.toggle('dark-mode',matchMedia('(prefers-color-scheme: dark)').matches)}})();
</script>{lang === 'en' && !is404 && <script is:inline>
(function(){var valid=['en','zh','zh-Hant','fr','es','it','de'],saved=null;try{saved=localStorage.getItem('zhwe-language')}catch(e){}function match(value){var tag=(value||'').toLowerCase();if(tag==='zh-hant'||/^zh-(tw|hk|mo)(-|$)/.test(tag)||tag.startsWith('zh-hant-'))return 'zh-Hant';var primary=tag.split('-')[0];return valid.includes(primary)?primary:null}var prefs=navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||'en'];var candidate=valid.includes(saved)?saved:prefs.map(match).find(Boolean)||'en';if(candidate!=='en')location.replace('/'+candidate+location.pathname+location.search+location.hash)})();
</script>}</head><body>
<header class="site-header"><div class="shell header-inner"><a class="brand" href={localPath('/',lang)} aria-label="ZHWE">ZHWE</a><nav class="main-nav" aria-label={t.nav}><a class="nav-search" href={localPath('/search/', lang)} aria-current={originalPath === '/search/' ? 'page' : undefined}>{searchLabels[lang].action}</a><a href={localPath('/',lang)}>{t.home}</a><a href={localPath('/about/',lang)}>{t.about}</a><a href={localPath('/links/',lang)}>{t.links}</a><a href={localPath('/建站日志/',lang)}>{t.history}</a><a href={localPath('/map/',lang)}>{t.map}</a></nav></div></header>
<slot/><footer class="site-footer"><div class="shell footer-inner"><div><a class="brand" href={localPath('/',lang)}>ZHWE</a><p>{t.tagline}</p></div><nav aria-label={t.footer}><a href={localPath('/about/',lang)}>{t.about}</a><a href={localPath('/links/',lang)}>{t.links}</a><a href={localPath('/隐私政策/',lang)}>{t.privacy}</a></nav><label class="language-select"><span class="sr-only">{t.language}</span><select aria-label={t.language}>{Object.entries(languages).map(([key,name]) => <option value={localPath(originalPath,key)} data-lang={key} selected={key===lang}>{name}</option>)}</select></label><fieldset class="theme-controls"><legend>{t.theme}</legend><div class="theme-options"><label><input type="radio" name="theme" value="light"/><span>{t.light}</span></label><label><input type="radio" name="theme" value="dark"/><span>{t.dark}</span></label><label><input type="radio" name="theme" value="system"/><span>{t.system}</span></label></div></fieldset><small>Copyright {new Date().getFullYear()} — ZHWE. All rights reserved.</small></div></footer>
<script is:inline>
(function(){
 const root=document.documentElement,system=window.matchMedia('(prefers-color-scheme: dark)'), inputs=[...document.querySelectorAll('input[name="theme"]')];
 let mode='system';try{const saved=localStorage.getItem('zhwe-theme'),legacy=localStorage.getItem('zhwe-dark');mode=['light','dark','system'].includes(saved)?saved:(legacy==='1'?'dark':legacy==='0'?'light':'system')}catch{}
 function apply(){root.classList.toggle('dark-mode',mode==='dark'||(mode==='system'&&system.matches));inputs.forEach(input=>input.checked=input.value===mode)}
 apply();inputs.forEach(input=>input.addEventListener('change',()=>{if(!input.checked)return;mode=input.value;try{localStorage.setItem('zhwe-theme',mode);localStorage.removeItem('zhwe-dark')}catch{}apply()}));
 system.addEventListener('change',()=>{if(mode==='system')apply()});
 const grids=[...document.querySelectorAll('.posts-grid')];if('ResizeObserver' in window){for(const grid of grids){grid.dataset.masonryReady='true';const update=card=>{const rows=Math.ceil((card.getBoundingClientRect().height+22)/8);if(rows>0)card.style.gridRowEnd='span '+rows};const observer=new ResizeObserver(entries=>entries.forEach(entry=>update(entry.target)));grid.querySelectorAll('.post-card').forEach(card=>{observer.observe(card);update(card)})}}
 const select=document.querySelector('.language-select select');select?.addEventListener('change',()=>{const opt=select.selectedOptions[0];try{localStorage.setItem('zhwe-language',opt.dataset.lang)}catch{}location.assign(select.value+location.search+location.hash)});
})();
</script></body></html>
