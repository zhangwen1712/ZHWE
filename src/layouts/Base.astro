---
import '../styles/site.css';
const {title = 'ZHWE - 欢迎来到我的站点. . .'} = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title set:html={title}/><link rel="stylesheet" href="/assets/bloglo.css"/><link rel="stylesheet" href="/assets/dynamic-styles.css"/></head><body>
<header class="site-header"><div class="brand bloglo-container"><div><a class="brand-title" href="/">ZHWE</a><p>欢迎来到我的站点. . .</p></div><a href="/"><img class="banner" src="https://zhwe.top/wp-content/uploads/2024/09/2024-08-28-20-06-32.webp" alt=""/></a><button class="theme-toggle" type="button" aria-label="切换深色模式">◐</button></div><nav class="main-nav" aria-label="主导航"><div class="bloglo-container"><a href="/about/">关于章文</a><a href="/links/">友情链接</a><a href="/建站日志/">建站日志</a><a href="/隐私政策/">隐私政策</a></div></nav></header>
<slot/><footer class="site-footer"><div class="bloglo-container">Copyright {new Date().getFullYear()} — ZHWE. All rights reserved.</div></footer>
<script is:inline>document.querySelector('.theme-toggle')?.addEventListener('click',()=>{document.body.classList.toggle('dark-mode');localStorage.setItem('zhwe-dark',document.body.classList.contains('dark-mode')?'1':'0')});if(localStorage.getItem('zhwe-dark')==='1')document.body.classList.add('dark-mode');</script></body></html>
