---
import '../styles/site.css';
const {title = 'ZHWE - 欢迎来到我的站点. . .', description = '你好，我是章文👏，这里是我的相簿🏞、日记本📔、垃圾桶。欢迎来到我的站点📫'} = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><title set:html={title}/></head><body>
<header class="site-header"><div class="shell header-inner"><a class="brand" href="/" aria-label="ZHWE 首页">ZHWE</a><nav class="main-nav" aria-label="主导航"><a href="/">首页</a><a href="/about/">关于章文</a><a href="/links/">友情链接</a><a href="/建站日志/">建站日志</a></nav><button class="theme-toggle" type="button" aria-label="切换深色模式">◐</button></div></header>
<slot/><footer class="site-footer"><div class="shell footer-inner"><div><a class="brand" href="/">ZHWE</a><p>欢迎来到我的站点. . .</p></div><nav aria-label="页脚导航"><a href="/about/">关于章文</a><a href="/links/">友情链接</a><a href="/隐私政策/">隐私政策</a></nav><small>Copyright {new Date().getFullYear()} — ZHWE. All rights reserved.</small></div></footer>
<script is:inline>try{if(localStorage.getItem('zhwe-dark')==='1')document.body.classList.add('dark-mode')}catch{}document.querySelector('.theme-toggle')?.addEventListener('click',()=>{document.body.classList.toggle('dark-mode');try{localStorage.setItem('zhwe-dark',document.body.classList.contains('dark-mode')?'1':'0')}catch{}});</script></body></html>
