---
const { postId, lang='zh' } = Astro.props;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '';
const texts={en:['Leave a comment','Name','Comment','Website','Submit comment','Comments are not yet available.','Submitting…','Comment submitted for review.','Comments are temporarily unavailable.'],'zh-Hant':['發表評論','暱稱','評論','網站','提交評論','評論服務尚未啟用。','提交中…','評論已提交，審核後顯示。','評論服務暫時無法使用。'],zh:['发表评论','昵称','评论','网站','提交评论','评论服务尚未启用。','提交中…','评论已提交，审核后显示。','评论服务暂不可用。'],fr:['Laisser un commentaire','Nom','Commentaire','Site web','Envoyer','Les commentaires ne sont pas encore activés.','Envoi…','Commentaire envoyé, en attente de modération.','Le service est indisponible.'],es:['Dejar un comentario','Nombre','Comentario','Sitio web','Enviar','Los comentarios aún no están activados.','Enviando…','Comentario enviado, pendiente de revisión.','El servicio no está disponible.'],it:['Lascia un commento','Nome','Commento','Sito web','Invia','I commenti non sono ancora attivi.','Invio…','Commento inviato, in attesa di moderazione.','Il servizio non è disponibile.'],de:['Kommentar schreiben','Name','Kommentar','Website','Absenden','Kommentare sind noch nicht aktiviert.','Wird gesendet…','Kommentar eingereicht und wartet auf Prüfung.','Der Dienst ist nicht verfügbar.']}[lang];
---
<section class="comment-form-section" data-post-id={postId} data-texts={JSON.stringify(texts)} data-sitekey={sitekey}><h2>{texts[0]}</h2><div class="live-comments"></div><form class="comment-form"><label>{texts[1]} <input name="author" required maxlength="40" autocomplete="nickname"/></label><label>{texts[2]} <textarea name="body" required maxlength="2000" rows="5"></textarea></label><label class="honeypot" aria-hidden="true">{texts[3]} <input name="website" tabindex="-1" autocomplete="off"/></label><div class="comment-turnstile"></div><button type="submit" disabled>{texts[4]}</button><p class="comment-status" role="status"></p></form></section>
<script>
import '../lib/comment-form.js';
</script>
