---
const { postId, lang='zh' } = Astro.props;
const texts={zh:['发表评论','昵称','评论','网站','提交评论','评论服务尚未启用。','提交中…','评论已提交，审核后显示。','评论服务暂不可用。'],fr:['Laisser un commentaire','Nom','Commentaire','Site web','Envoyer','Les commentaires ne sont pas encore activés.','Envoi…','Commentaire envoyé, en attente de modération.','Le service est indisponible.'],es:['Dejar un comentario','Nombre','Comentario','Sitio web','Enviar','Los comentarios aún no están activados.','Enviando…','Comentario enviado, pendiente de revisión.','El servicio no está disponible.'],it:['Lascia un commento','Nome','Commento','Sito web','Invia','I commenti non sono ancora attivi.','Invio…','Commento inviato, in attesa di moderazione.','Il servizio non è disponibile.'],de:['Kommentar schreiben','Name','Kommentar','Website','Absenden','Kommentare sind noch nicht aktiviert.','Wird gesendet…','Kommentar eingereicht und wartet auf Prüfung.','Der Dienst ist nicht verfügbar.']}[lang];
---
<section class="comment-form-section" data-post-id={postId} data-texts={JSON.stringify(texts)}><h2>{texts[0]}</h2><div class="live-comments"></div><form class="comment-form"><label>{texts[1]} <input name="author" required maxlength="40" autocomplete="nickname"/></label><label>{texts[2]} <textarea name="body" required maxlength="2000" rows="5"></textarea></label><label class="honeypot" aria-hidden="true">{texts[3]} <input name="website" tabindex="-1" autocomplete="off"/></label><button type="submit">{texts[4]}</button><p class="comment-status" role="status"></p></form></section>
<script>
for (const section of document.querySelectorAll('.comment-form-section')) {
 const texts=JSON.parse(section.getAttribute('data-texts') || '[]'); const form = section.querySelector('form'); const status = section.querySelector('.comment-status'); const list = section.querySelector('.live-comments'); const post = Number(section.getAttribute('data-post-id'));
 fetch(`/api/comments?post=${post}`).then(async response => { if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) throw new Error(); const data = await response.json(); for (const comment of data.comments) { const item = document.createElement('article'); item.className = 'comment-body'; const name = document.createElement('strong'); name.textContent = comment.author; const body = document.createElement('p'); body.textContent = comment.body; item.append(name,body); list?.append(item); } }).catch(() => { if (status) status.textContent = texts[5]; });
 form?.addEventListener('submit', async event => { event.preventDefault(); if (!(form instanceof HTMLFormElement)) return; const button = form.querySelector('button'); if (button) button.disabled = true; if (status) status.textContent = texts[6]; const data = new FormData(form); try { const response = await fetch('/api/comments', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({post,author:data.get('author'),body:data.get('body'),website:data.get('website')})}); const payload = await response.json(); if (!response.ok) throw new Error(payload.error); form.reset(); if (status) status.textContent = texts[7]; } catch(error) { if (status) status.textContent = texts[8]; } finally { if (button) button.disabled = false; } });
}
</script>
