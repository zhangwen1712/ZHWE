---
const { postId } = Astro.props;
---
<section class="comment-form-section" data-post-id={postId}><h2>发表评论</h2><div class="live-comments"></div><form class="comment-form"><label>昵称 <input name="author" required maxlength="40" autocomplete="nickname"/></label><label>评论 <textarea name="body" required maxlength="2000" rows="5"></textarea></label><label class="honeypot" aria-hidden="true">网站 <input name="website" tabindex="-1" autocomplete="off"/></label><button type="submit">提交评论</button><p class="comment-status" role="status"></p></form></section>
<script>
for (const section of document.querySelectorAll('.comment-form-section')) {
 const form = section.querySelector('form'); const status = section.querySelector('.comment-status'); const list = section.querySelector('.live-comments'); const post = Number(section.getAttribute('data-post-id'));
 fetch(`/api/comments?post=${post}`).then(async response => { if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) throw new Error(); const data = await response.json(); for (const comment of data.comments) { const item = document.createElement('article'); item.className = 'comment-body'; const name = document.createElement('strong'); name.textContent = comment.author; const body = document.createElement('p'); body.textContent = comment.body; item.append(name,body); list?.append(item); } }).catch(() => { if (status) status.textContent = '评论服务尚未启用。'; });
 form?.addEventListener('submit', async event => { event.preventDefault(); if (!(form instanceof HTMLFormElement)) return; const button = form.querySelector('button'); if (button) button.disabled = true; if (status) status.textContent = '提交中…'; const data = new FormData(form); try { const response = await fetch('/api/comments', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({post,author:data.get('author'),body:data.get('body'),website:data.get('website')})}); const payload = await response.json(); if (!response.ok) throw new Error(payload.error); form.reset(); if (status) status.textContent = payload.message; } catch(error) { if (status) status.textContent = error instanceof Error && error.message && !error.message.includes('JSON') ? error.message : '评论服务暂不可用。'; } finally { if (button) button.disabled = false; } });
}
</script>
