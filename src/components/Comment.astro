---
import Comment from './Comment.astro';
const { comment, comments } = Astro.props;
const replies = comments.filter((entry) => entry.parent === comment.id);
---
<li class="comment"><div class="comment-body"><strong>{comment.author_name}</strong><time datetime={comment.date}>{new Date(comment.date).toLocaleDateString('zh-CN')}</time><div set:html={comment.content.rendered}></div></div>{replies.length > 0 && <ol class="replies">{replies.map(reply => <Comment comment={reply} comments={comments} />)}</ol>}</li>
