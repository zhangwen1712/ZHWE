---
const { post } = Astro.props;
const path = new URL(post.link).pathname;
const date = new Date(post.date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});
---
<article class="bloglo-article post-card">{post.image && <a href={path}><img class="card-image" src={post.image} alt="" loading="lazy"/></a>}<header class="entry-header"><h2 class="entry-title"><a href={path} set:html={post.title.rendered}/></h2></header><div class="entry-meta">By 章文　{date}</div><div class="entry-summary" set:html={post.excerpt.rendered}/></article>
