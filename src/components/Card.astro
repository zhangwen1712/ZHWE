---
import categories from '../../migration/categories.json';
const { post, featured = false } = Astro.props;
const path = new URL(post.link).pathname;
const date = new Date(post.date).toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'});
const category = categories.find(c => post.categories.includes(c.id));
const image = post.image?.replace('https://zhwe.top/wp-content/uploads/', '/wp-content/uploads/');
---
<article class:list={['post-card', {'post-card-featured': featured}]}><a class="card-link" href={path} aria-label={`阅读 ${post.title.rendered}`}><div class="card-media">{image ? <img src={image} alt="" loading="lazy"/> : <div class="card-placeholder"><span>ZHWE</span></div>}</div><div class="card-body"><div class="card-kicker">{category && <span>{category.name}</span>}<time datetime={post.date}>{date}</time></div><h2 set:html={post.title.rendered}></h2><div class="excerpt" set:html={post.excerpt.rendered}></div><span class="card-more">阅读全文 <span aria-hidden="true">↗</span></span></div></a></article>
