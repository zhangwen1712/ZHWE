---
import Base from '../layouts/Base.astro';
import {localPath} from '../i18n.js';
import defaultPosts from '../../migration/published-posts.json';
import places from '../../migration/article-locations.json';
const {lang='zh',posts=defaultPosts}=Astro.props;
const copy={
 en:{title:'Footprints',visited:'Places visited',country:'China · Thailand',current:'Author’s location',locate:'Calculate distance',note:'Location permission is required. Distance is calculated in your browser; the map provider can infer the area viewed.',result:'About {distance} km from the author',denied:'Unable to get your location. Check browser permissions.',unsupported:'Geolocation is unavailable.',articles:'posts',approx:'Article locations are approximate city locations.',mapLabel:'World map of article locations',articlePin:'Posts',visitedPin:'Places visited',currentPin:'Author',unlocated:'other posts have no location'},
 'zh-Hant':{title:'足跡',visited:'去過的國家和地區',country:'中國 · 泰國',current:'博主位置',locate:'計算與博主的距離',note:'需要取得位置權限；距離僅在瀏覽器中計算。地圖服務可透過地圖視圖推測大致區域。',result:'距博主約 {distance} 公里',denied:'無法取得位置，請檢查瀏覽器定位權限。',unsupported:'目前的瀏覽器不支援定位。',articles:'篇文章',approx:'文章位置為城市級近似位置。',mapLabel:'文章地點世界地圖',articlePin:'文章地點',visitedPin:'到訪地點',currentPin:'博主位置',unlocated:'其餘文章暫未標註地點'},
 zh:{title:'足迹',visited:'去过的国家和地区',country:'中国 · 泰国',regions:'山西：太原、平遥、运城；陕西：西安；北京；天津；山东：威海、烟台、青岛、泰山；广东：深圳、惠州、广州、佛山；香港；澳门；泰国：曼谷、普吉',current:'博主位置',locate:'计算与博主的距离',note:'需要获得位置权限；距离仅在你的浏览器中计算。地图服务可通过地图视图推测大致区域。',result:'距博主约 {distance} 公里',denied:'无法获取位置，请检查浏览器定位权限。',unsupported:'当前浏览器不支持定位。',articles:'篇文章',approx:'文章位置为城市级近似位置。',mapLabel:'文章地点世界地图',articlePin:'文章地点',visitedPin:'到访地点',currentPin:'博主位置',unlocated:'其余文章暂未标注地点'},
 fr:{title:'Mes pas',visited:'Pays et régions visités',country:'Chine · Thaïlande',regions:'Taiyuan · Pingyao · Yuncheng · Xi’an · Pékin · Tianjin · Weihai · Yantai · Qingdao · Mont Tai · Shenzhen · Huizhou · Guangzhou · Foshan · Hong Kong · Macao · Bangkok · Phuket',current:'Position de l’auteur',locate:'Calculer la distance',note:'La localisation nécessite votre autorisation ; la distance est calculée dans votre navigateur. Le fournisseur de carte peut déduire la zone affichée.',result:'À environ {distance} km de l’auteur',denied:'Position indisponible. Vérifiez les autorisations.',unsupported:'La géolocalisation n’est pas disponible.',articles:'articles',approx:'Les positions des articles sont approximatives, à l’échelle de la ville.',mapLabel:'Carte mondiale des articles',articlePin:'Articles',visitedPin:'Lieux visités',currentPin:'Auteur',unlocated:'Les autres articles ne sont pas localisés'},
 es:{title:'Mis pasos',visited:'Países y regiones visitados',country:'China · Tailandia',regions:'Taiyuan · Pingyao · Yuncheng · Xi’an · Pekín · Tianjin · Weihai · Yantai · Qingdao · Monte Tai · Shenzhen · Huizhou · Guangzhou · Foshan · Hong Kong · Macao · Bangkok · Phuket',current:'Ubicación del autor',locate:'Calcular distancia',note:'Se requiere permiso de ubicación; la distancia se calcula en tu navegador. El proveedor del mapa puede deducir la zona mostrada.',result:'A unos {distance} km del autor',denied:'No se pudo obtener la ubicación. Revisa los permisos.',unsupported:'La geolocalización no está disponible.',articles:'artículos',approx:'Las ubicaciones son aproximadas a nivel de ciudad.',mapLabel:'Mapa mundial de artículos',articlePin:'Artículos',visitedPin:'Lugares visitados',currentPin:'Autor',unlocated:'Los demás artículos aún no tienen ubicación'},
 it:{title:'I miei passi',visited:'Paesi e regioni visitati',country:'Cina · Thailandia',regions:'Taiyuan · Pingyao · Yuncheng · Xi’an · Pechino · Tianjin · Weihai · Yantai · Qingdao · Monte Tai · Shenzhen · Huizhou · Guangzhou · Foshan · Hong Kong · Macao · Bangkok · Phuket',current:'Posizione dell’autore',locate:'Calcola la distanza',note:'Serve il permesso di localizzazione; la distanza viene calcolata nel browser. Il fornitore della mappa può dedurre l’area visualizzata.',result:'A circa {distance} km dall’autore',denied:'Posizione non disponibile. Controlla i permessi.',unsupported:'Geolocalizzazione non disponibile.',articles:'articoli',approx:'Le posizioni sono approssimative a livello di città.',mapLabel:'Mappa mondiale degli articoli',articlePin:'Articoli',visitedPin:'Luoghi visitati',currentPin:'Autore',unlocated:'Gli altri articoli non sono ancora localizzati'},
 de:{title:'Meine Spuren',visited:'Besuchte Länder und Regionen',country:'China · Thailand',regions:'Taiyuan · Pingyao · Yuncheng · Xi’an · Peking · Tianjin · Weihai · Yantai · Qingdao · Tai Shan · Shenzhen · Huizhou · Guangzhou · Foshan · Hongkong · Macau · Bangkok · Phuket',current:'Standort des Autors',locate:'Entfernung berechnen',note:'Die Standortfreigabe ist erforderlich; die Entfernung wird im Browser berechnet. Der Kartenanbieter kann das angezeigte Gebiet ableiten.',result:'Etwa {distance} km vom Autor entfernt',denied:'Standort nicht verfügbar. Bitte Berechtigungen prüfen.',unsupported:'Standortbestimmung ist nicht verfügbar.',articles:'Beiträge',approx:'Die Orte sind auf Stadtebene angenähert.',mapLabel:'Weltkarte der Beiträge',articlePin:'Beiträge',visitedPin:'Besuchte Orte',currentPin:'Autor',unlocated:'Weitere Beiträge sind noch nicht verortet'}
}[lang];
const extras={en:{home:'Hometown',you:'Your location',waiting:'Finding your location…'},'zh-Hant':{home:'家鄉',you:'你的位置',waiting:'正在取得你的位置…'},zh:{home:'家乡',you:'你的位置',waiting:'正在获取你的位置…'},fr:{home:'Ville natale',you:'Votre position',waiting:'Localisation en cours…'},es:{home:'Ciudad natal',you:'Tu ubicación',waiting:'Obteniendo tu ubicación…'},it:{home:'Città natale',you:'La tua posizione',waiting:'Rilevamento della posizione…'},de:{home:'Heimatstadt',you:'Dein Standort',waiting:'Standort wird ermittelt…'}}[lang];
const placeName=p=>p.names[lang] || (lang==='zh-Hant'?p.names.zh:p.names.fr);
const visited=[...places.locations,...places.visitedPlaces,places.currentLocation].map(p=>({...p,names:{...p.names,[lang]:placeName(p)}}));
const data=places.locations.map(place=>({...place,name:placeName(place),articles:place.articleIds.map(id=>posts.find(post=>post.id===id)).filter(Boolean).map(post=>({title:post.title.rendered,path:localPath(new URL(post.link).pathname,lang)}))}));
---
<Base lang={lang} title={`${copy.title} - ZHWE`}>
<main class="shell map-page experience-map">
  <h1>{copy.title}</h1>
  <div class="map-canvas-wrap">
    <div id="article-map" class="article-map" role="region" aria-label={copy.mapLabel} data-places={JSON.stringify(data)} data-strings={JSON.stringify(copy)} data-current={JSON.stringify({...places.currentLocation,names:{...places.currentLocation.names,[lang]:placeName(places.currentLocation)}})} data-language={lang} data-extras={JSON.stringify(extras)}></div>
    <div class="map-overlay-legend"><span><i class="legend-visited"></i>{copy.visitedPin}</span><span><i class="legend-article"></i>{copy.articlePin}</span></div>
  </div>
  <div class="map-content">
    <section class="map-journeys"><h2>{copy.visited}</h2><p class="map-countries">{copy.country}</p><div class="map-destinations">{visited.map(place=><button type="button" class="map-destination" data-longitude={place.longitude} data-latitude={place.latitude}>{place.names[lang]}</button>)}</div></section>
    <section class="map-distance-card"><h2>{copy.current}</h2><p>{placeName(places.currentLocation)}</p><button class="map-locate" type="button">{copy.locate}</button><p class="map-note">{copy.note}</p><p class="map-distance" role="status"></p></section>
  </div>
  <details class="map-article-details"><summary>{copy.articlePin}</summary><p class="map-note">{copy.approx} {places.unlocatedArticleIds.length} {copy.unlocated}</p><ul class="map-place-list">{data.map(p=><li><strong>{p.name}</strong><span>{p.articles.length} {copy.articles}</span><ul>{p.articles.map(a=><li><a href={a.path} set:html={a.title}/></li>)}</ul></li>)}</ul></details>
  <p class="map-source"><a href="https://openfreemap.org/">OpenFreeMap</a> · <a href="https://www.naturalearthdata.com/">Natural Earth</a> · <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · <a href="https://github.com/Supeset/China-GeoData">China-GeoData</a> · <a href="https://www.geoboundaries.org/">geoBoundaries</a></p>
</main></Base>
<script>
import * as maplibregl from 'maplibre-gl';
import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
maplibregl.setWorkerUrl(workerUrl);
import 'maplibre-gl/dist/maplibre-gl.css';
import {distanceKm} from '../lib/distance.js';
const element=document.getElementById('article-map');
if(element){
 const places=JSON.parse(element.dataset.places||'[]'),copy=JSON.parse(element.dataset.strings||'{}'),current=JSON.parse(element.dataset.current||'{}'),lang=element.dataset.language||'zh',extras=JSON.parse(element.dataset.extras||'{}');
 const button=document.querySelector('.map-locate'),result=document.querySelector('.map-distance');
 let map, visitorMarker, visitorPosition;

 try {
  let mapStyle;
  try {
   const response=await fetch('https://tiles.openfreemap.org/styles/positron',{signal:AbortSignal.timeout(6000)});
   if(!response.ok)throw new Error(`Map style: ${response.status}`);
   mapStyle=await response.json();
   for(const layer of mapStyle.layers){if(layer.type==='symbol'&&layer.id.startsWith('label_')&&layer.layout?.['text-field'])layer.layout['text-field']=['coalesce',['get',`name:${lang}`],['get',`name_${lang}`],['get','name'],['get','name:latin']];}
  } catch(error) {
   console.warn('Detailed map unavailable; using local basemap.',error);
   mapStyle={version:8,sources:{world:{type:'geojson',data:'/map/world.geojson',attribution:'<a href="https://www.naturalearthdata.com/">Natural Earth</a>'}},layers:[{id:'water',type:'background',paint:{'background-color':'#e8edf0'}},{id:'land',type:'fill',source:'world',paint:{'fill-color':'#f8f7f4'}},{id:'borders',type:'line',source:'world',paint:{'line-color':'#d2d7dc','line-width':0.7}}]};
  }
  map=new maplibregl.Map({container:element,style:mapStyle,center:[109,27],zoom:window.innerWidth<600?2.5:3.2,scrollZoom:false});
  map.addControl(new maplibregl.NavigationControl({showCompass:false}),'top-right');
  map.on('load',()=>{
   map.addSource('visited-regions',{type:'geojson',data:'/map/visited-regions.geojson'});
   const firstLabel=map.getStyle().layers.find(layer=>layer.type==='symbol')?.id;
   map.addLayer({id:'visited-fill',type:'fill',source:'visited-regions',paint:{'fill-color':'#8067cf','fill-opacity':0.48}},firstLabel);
   map.addLayer({id:'visited-outline',type:'line',source:'visited-regions',paint:{'line-color':'#7459c2','line-width':1.1,'line-opacity':0.8}},firstLabel);
  });
  for(const place of places){
   const marker=document.createElement('button');marker.type='button';marker.className='journey-pin';marker.setAttribute('aria-label',`${place.name} · ${place.articles.length} ${copy.articles}`);
   const box=document.createElement('div'),title=document.createElement('strong'),list=document.createElement('ul');title.textContent=place.name;box.append(title);
   for(const article of place.articles){const li=document.createElement('li'),a=document.createElement('a');a.href=article.path;a.textContent=new DOMParser().parseFromString(article.title,'text/html').body.textContent;li.append(a);list.append(li)}box.append(list);
   new maplibregl.Marker({element:marker,anchor:'center'}).setLngLat([place.longitude,place.latitude]).setPopup(new maplibregl.Popup({offset:18,maxWidth:'260px'}).setDOMContent(box)).addTo(map);
   if(place.id==='pingyao'){const home=document.createElement('div');home.className='journey-home';home.setAttribute('role','img');home.setAttribute('aria-label',`${extras.home}: ${place.name}`);home.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>';new maplibregl.Marker({element:home,anchor:'bottom',offset:[0,-13]}).setLngLat([place.longitude,place.latitude]).addTo(map)}
  }
  const author=document.createElement('div');author.className='journey-author';author.setAttribute('aria-label',`${copy.current}: ${current.names[lang]}`);const dot=document.createElement('span'),label=document.createElement('span');dot.className='journey-author-dot';label.className='journey-author-label';label.textContent="Hi, I'm here";author.append(dot,label);
  new maplibregl.Marker({element:author,anchor:'left'}).setLngLat([current.longitude,current.latitude]).addTo(map);
  document.querySelectorAll('.map-destination[data-longitude]').forEach(chip=>chip.addEventListener('click',()=>map.flyTo({center:[Number(chip.dataset.longitude),Number(chip.dataset.latitude)],zoom:7,duration:matchMedia('(prefers-reduced-motion: reduce)').matches?0:900})));
 } catch(error) {console.error('Map unavailable:',error); element.classList.add('map-unavailable');}
 function drawConnection(){
  if(!map||!visitorPosition)return;
  if(!map.isStyleLoaded()){map.once('idle',drawConnection);return}
  const [longitude,latitude]=visitorPosition;let authorLongitude=current.longitude;
  while(authorLongitude-longitude>180)authorLongitude-=360;
  while(authorLongitude-longitude< -180)authorLongitude+=360;
  const line={type:'Feature',properties:{},geometry:{type:'LineString',coordinates:[[longitude,latitude],[authorLongitude,current.latitude]]}};
  const source=map.getSource('visitor-connection');
  if(source)source.setData(line);else{map.addSource('visitor-connection',{type:'geojson',data:line});map.addLayer({id:'visitor-connection',type:'line',source:'visitor-connection',paint:{'line-color':'#db776b','line-width':2,'line-opacity':0.85,'line-dasharray':[2,2]}})}
  if(visitorMarker)visitorMarker.remove();
  const visitor=document.createElement('div');visitor.className='journey-visitor';visitor.setAttribute('role','img');visitor.setAttribute('aria-label',extras.you);const visitorDot=document.createElement('span'),visitorLabel=document.createElement('span');visitorDot.className='journey-visitor-dot';visitorLabel.className='journey-visitor-label';visitorLabel.textContent=extras.you;visitor.append(visitorDot,visitorLabel);
  visitorMarker=new maplibregl.Marker({element:visitor,anchor:'left',offset:[-8,0]}).setLngLat([longitude,latitude]).addTo(map);
  map.fitBounds([[Math.min(longitude,authorLongitude),Math.min(latitude,current.latitude)],[Math.max(longitude,authorLongitude),Math.max(latitude,current.latitude)]],{padding:80,maxZoom:8,duration:matchMedia('(prefers-reduced-motion: reduce)').matches?0:900});
 }
 function locate(){
  if(!navigator.geolocation){if(result)result.textContent=copy.unsupported;return}
  if(result)result.textContent=extras.waiting;
  navigator.geolocation.getCurrentPosition(position=>{visitorPosition=[position.coords.longitude,position.coords.latitude];const km=distanceKm(position.coords.latitude,position.coords.longitude,current.latitude,current.longitude);if(result)result.textContent=copy.result.replace('{distance}',new Intl.NumberFormat(lang==='zh'?'zh-CN':lang,{maximumFractionDigits:0}).format(km));drawConnection()},()=>{if(result)result.textContent=copy.denied},{enableHighAccuracy:false,timeout:10000,maximumAge:300000});
 }
 button?.addEventListener('click',locate);
 locate();
}
</script>
