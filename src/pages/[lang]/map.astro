---
import MapPage from '../../components/MapPage.astro';
import {localeData} from '../../locale-data.js';
export function getStaticPaths(){return Object.entries(localeData).filter(([lang])=>lang!=='en').map(([lang,data])=>({params:{lang},props:{posts:data['published-posts']}}));}
const {lang}=Astro.params;const {posts}=Astro.props;
---
<MapPage lang={lang} posts={posts}/>
