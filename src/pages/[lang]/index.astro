---
import Home from '../../components/Home.astro';
import {localeData,localeDictionaries} from '../../locale-data.js';
export function getStaticPaths(){return Object.keys(localeData).filter(lang=>lang!=='en').map(lang=>({params:{lang}}));}
const {lang}=Astro.params;const data=localeData[lang];
---
<Home lang={lang} posts={data['published-posts']} categories={data.categories} translations={localeDictionaries[lang]}/>
